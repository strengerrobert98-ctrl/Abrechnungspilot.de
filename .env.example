# Kopiere diese Datei zu ".env" und trage deinen echten Anthropic API-Key ein.
# Die ".env"-Datei wird NICHT ins Frontend geladen und sollte nie geteilt oder committet werden.

ANTHROPIC_API_KEY=dein-api-key-hier

# Optional: Modell und Port anpassen
# claude-opus-5 = leistungsfähiger, etwas teurer. claude-sonnet-5 = günstiger, gut für Tests.
ANTHROPIC_MODEL=claude-opus-5
PORT=3000
